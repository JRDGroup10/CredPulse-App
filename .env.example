# Copy this file to .env.local and fill in your own Supabase project's values.
# Find both under: Supabase dashboard -> your project -> Project Settings -> API.
# .env.local is gitignored — never commit real keys.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public VAPID key for push notifications (safe to expose in frontend code —
# it's the "public" half of the pair). Generate a pair with:
#   npx web-push generate-vapid-keys
# Set the private key as a Supabase Edge Function secret instead (VAPID_PRIVATE_KEY),
# never here. See PUSH_SETUP.md.
VITE_VAPID_PUBLIC_KEY=your-public-vapid-key

# Optional: reports uncaught runtime errors to Sentry instead of them just
# vanishing silently in whichever browser hit them. Get a DSN from
# sentry.io -> your project -> Settings -> Client Keys (DSN). Safe to leave
# unset — the app runs fine without it, just with no error visibility.
VITE_SENTRY_DSN=
